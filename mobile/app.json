{
  "expo": {
    "name": "Kore",
    "slug": "kore",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kore",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#edf1f4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.kore.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Kore usa el micrófono para el modo audio (notas de voz)."
      }
    },
    "android": {
      "package": "dev.kore.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1f6f5b"
      },
      "permissions": ["RECORD_AUDIO"],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
