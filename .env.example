# --- Telegram ---
# Token del bot, obtenido de @BotFather
TELEGRAM_BOT_TOKEN=

# String aleatorio para el header X-Telegram-Bot-Api-Secret-Token
# Generar con: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Segmento aleatorio para la URL del webhook (defensa en profundidad, no es el gate real)
# Generar con: openssl rand -hex 32
TELEGRAM_WEBHOOK_PATH_SECRET=

# chat_id de Telegram al que el bot va a responder (todo lo demás se ignora)
# Para obtenerlo: escríbele al bot una vez y consulta
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ALLOWED_CHAT_ID=

# --- LLM (OpenRouter) ---
# API key de openrouter.ai (Keys)
OPENROUTER_API_KEY=
# Formato "proveedor/modelo"
# Diario (chat + tools): DeepSeek V4 Pro. Gorda (coach/research): Claude.
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_MODEL_STRONG=anthropic/claude-haiku-4.5
# Alt dogfood: moonshotai/kimi-k2.5 · fallback quality: anthropic/claude-sonnet-4.6
# Strong más caro (alt): anthropic/claude-opus-4.8
# Barato multimodal (alt): xiaomi/mimo-v2.5
# STT consola (mic → texto). Misma API key OpenRouter
# OPENROUTER_STT_MODEL=openai/whisper-1
# OPENROUTER_STT_LANGUAGE=es
LLM_MAX_TOKENS=4096
# Tope USD para el chip % si la key no tiene limit (opcional)
# OPENROUTER_BUDGET_USD=20
# TIMEZONE=Europe/Madrid

# --- ClickUp ---
# Personal API token: Ajustes -> Apps -> API Token -> Generate (no caduca)
CLICKUP_API_TOKEN=

# --- App ---
# Nombre con el que te habla el companion (se puede cambiar cuando quieras)
ASSISTANT_NAME=Jone
# Tu nombre en la consola (saludo del Día)
OWNER_NAME=Jon
LOG_LEVEL=INFO
# STORAGE_DB_PATH=data/kore.db
# Vault markdown (memory/diary/agenda/dreams). Empty → <parent of DB>/vault
# VAULT_ROOT=data/vault

# Bearer para POST /internal/cron/dream (manual / opcional). Generar: openssl rand -hex 32
# Mismo valor en Fly secret CRON_SECRET
CRON_SECRET=

# Sueño matutino in-process (Europe/Madrid). Default 09:00.
# DREAM_CRON_ENABLED=true
# DREAM_CRON_HOUR=9
# DREAM_CRON_MINUTE=0
# Ping Telegram al cron (default false: el briefing se ve en vista Día de la consola)
# DREAM_NOTIFY_TELEGRAM=false

# Consola web (/api/*). Cookie o Bearer. Generar: openssl rand -hex 32
# Fly: fly secrets set CONSOLE_SECRET=... -a kore
# CONSOLE_SECRET=

# Cortar cuenta: make account-off EMAIL=ana@x.com
# Tope LLM/mes por home (USD). 0 = sin corte. Bajo para dogfood del corte.
# PILOT_LLM_CAP_USD=0.5

# Stripe (Checkout + webhooks). Vacío = sin paywall (local).
# Tres planes: 5 / 10 / 20 € al mes. El de 5 € es la puerta.
# Endpoint: https://kore.fly.dev/api/stripe/webhook
# Eventos: checkout.session.completed, invoice.paid, invoice.payment_failed,
# customer.subscription.updated, customer.subscription.deleted
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_5=
# STRIPE_PRICE_10=
# STRIPE_PRICE_20=
# PUBLIC_ORIGIN=https://kore.fly.dev

# --- Google OAuth (Gmail + Calendar read) ---
# Enable Gmail API + Google Calendar API in GCP (same project as OAuth client).
# Calendar API: https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
# Scopes: gmail.modify, gmail.send, calendar.readonly, calendar.events
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Redirect URI autorizado = GOOGLE_OAUTH_REDIRECT_URI
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://kore.fly.dev/api/gmail/callback
# Local: http://127.0.0.1:8000/api/gmail/callback

# Cargar también skills/dev/*.md en el bot Telegram (por defecto solo Cursor)
# LOAD_DEV_SKILLS=false

# --- Despliegue (Fly.io) ---
# Hostname de la app en Fly.io. No lo lee la app Python;
# solo lo usa scripts/set_webhook.sh.
DOMAIN=kore.fly.dev
