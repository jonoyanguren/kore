# --- Telegram ---
# Token del bot, obtenido de @BotFather
TELEGRAM_BOT_TOKEN=

# String aleatorio para el header X-Telegram-Bot-Api-Secret-Token
# Generar con: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Segmento aleatorio para la URL del webhook (defensa en profundidad, no es el gate real)
# Generar con: openssl rand -hex 32
TELEGRAM_WEBHOOK_PATH_SECRET=

# chat_id de Telegram al que el bot va a responder (todo lo demás se ignora)
# Para obtenerlo: escríbele al bot una vez y consulta
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ALLOWED_CHAT_ID=

# --- LLM (OpenRouter) ---
# API key de openrouter.ai (Keys)
OPENROUTER_API_KEY=
# Formato "proveedor/modelo" — cambiar esto no requiere tocar código
OPENROUTER_MODEL=anthropic/claude-sonnet-5
LLM_MAX_TOKENS=2048

# --- App ---
LOG_LEVEL=INFO

# --- Despliegue (Caddy) ---
# Dominio/subdominio que apunta a la IP del servidor Hetzner. No lo lee la app Python.
DOMAIN=
# Email para el registro de Let's Encrypt. No lo lee la app Python.
ACME_EMAIL=
